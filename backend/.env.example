# ---- Server ----
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://127.0.0.1:5500

# ---- Database ----
# Free option: MongoDB Atlas (atlas.mongodb.com) -> create cluster -> get connection string
MONGO_URI=mongodb://127.0.0.1:27017/speedtopup

# ---- OTP / SMS (Termii - termii.com) ----
# Leave TERMII_API_KEY empty to run in DEV MODE: OTPs print to the server console
# and are also returned in the API response (devOtp) so you can test without paying for SMS.
TERMII_API_KEY=
TERMII_SENDER_ID=Speed Topup

# ---- VTU Aggregator (VTpass - vtpass.com) ----
# Sign up at vtpass.com, verify your account, then get sandbox keys from
# https://vtpass.com/developer (sandbox first, live keys only after you fund a live wallet)
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# ---- Payments (Paystack - paystack.com) ----
# Sign up, verify your account, then get your TEST keys first from
# Settings -> API Keys & Webhooks (test keys start with sk_test_ / pk_test_).
# Test mode lets you simulate real payments with fake cards - no real money moves.
# Only switch to live keys (sk_live_.../pk_live_...) once you've tested the full flow.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Crypto Payments (NOWPayments - nowpayments.io) ----
# Sign up, verify your account, then get your API key from
# Settings -> API Keys. Sandbox/test mode is available for trying the flow
# before going live. Supports USDT, BTC, BNB, and 300+ other coins through
# one hosted invoice page - customers pick their coin there.
NOWPAYMENTS_API_KEY=

# ---- Admin Dashboard ----
# Comma-separated list of emails to auto-promote to admin on their next login
# (register a normal account with this email first, then add it here and
# restart the backend - no separate admin-creation step needed).
ADMIN_EMAILS=

# ---- Email Notifications (Resend - resend.com) ----
# Sign up at resend.com (free tier: 100 emails/day, 3,000/month), verify your
# account, then get your API key from the Resend dashboard -> API Keys.
# Leave RESEND_API_KEY empty to run in DEV MODE: emails print to the server
# console instead of sending for real, so you can test the full flow for free.
# RESEND_FROM_EMAIL can stay as the default "onboarding@resend.dev" sender for
# testing, but Resend will only deliver that to your own account email until
# you verify a real domain under Domains in their dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Speed Topup Data <onboarding@resend.dev>

# ---- WhatsApp Ordering (Meta WhatsApp Cloud API) ----
# 1. Create a Meta developer account at developers.facebook.com, create an
#    app, and add the "WhatsApp" product - this gives you a free test number.
# 2. From WhatsApp > API Setup, copy the "Phone number ID" and a temporary
#    access token (or generate a permanent one under System Users for
#    production - temporary tokens expire in 24 hours).
# 3. Under App Settings > Basic, copy the "App Secret" - used to verify that
#    incoming webhook requests really came from Meta.
# 4. Pick any random string for WHATSAPP_VERIFY_TOKEN yourself - you'll enter
#    the SAME value in Meta's webhook setup screen (Meta just echoes it back
#    once to prove you control the URL).
# 5. In WhatsApp > Configuration, set the webhook URL to
#    https://<your-domain>/api/whatsapp/webhook and paste your verify token,
#    then subscribe to the "messages" field.
# During development, ngrok (or similar) gives you a public HTTPS URL that
# tunnels to your local server, since Meta won't call http://localhost.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
